# MindForge backend configuration
# Copy this file to `.env` for local development. Never commit `.env`.
# In Render production, enter these as environment variables in the Render Dashboard.

APP_NAME=MindForge API
APP_VERSION=1.0.0
API_PREFIX=/api
HOST=0.0.0.0
PORT=8000

# ==============================================================================
# CORS Configuration
# ==============================================================================
# In local development:
#   Defaults to common local ports (5500, 5501, 8000, 3000) and any loopback port.
#
# In production on Render:
#   Set CORS_ORIGINS to your exact Vercel production origin(s), comma-separated.
#   Example:
#     CORS_ORIGINS=https://<your-vercel-app>.vercel.app
#   If you also want local development clients to call this Render backend:
#     CORS_ORIGINS=https://<your-vercel-app>.vercel.app,http://localhost:5500,http://127.0.0.1:5500
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:5501,http://127.0.0.1:5501,http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000,http://127.0.0.1:3000

# Optional CORS Regex Pattern:
# By default, matches loopback hosts (http(s)://localhost|127.0.0.1|::1 on any port).
# To enable Vercel preview branch deployments without opening CORS to arbitrary sites,
# set CORS_ORIGIN_REGEX to match only your project's preview domains:
#   CORS_ORIGIN_REGEX=^https://<your-vercel-project>-[a-z0-9-]+\.vercel\.app$
# Set to an empty value to disable the pattern completely and rely exclusively on CORS_ORIGINS.
# CORS_ORIGIN_REGEX=^https?://(?:localhost|127\.0\.0\.1|\[::1\])(?::\d{1,5})?$

# ==============================================================================
# Google Gemini API (Server-Side Secret)
# ==============================================================================
# Get a key from Google AI Studio: https://aistudio.google.com/apikey
# NEVER put this key in frontend code, Vercel variables, or committed repository files.
GEMINI_API_KEY=your-gemini-api-key-here

# Pick a supported model from https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-3.6-flash

# Request timeout in seconds (1-120) and transient-failure retry count (0-3).
GEMINI_TIMEOUT_SECONDS=45
GEMINI_MAX_RETRIES=2
