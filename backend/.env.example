# MindForge backend configuration
# Copy this file to `.env` and replace the placeholders. Never commit `.env`.
APP_NAME=MindForge API
APP_VERSION=1.0.0
API_PREFIX=/api
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:5501,http://127.0.0.1:5501,http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000,http://127.0.0.1:3000
# Optional loopback-only pattern for local dev servers on other ports.
# The default allows http(s)://localhost|127.0.0.1|::1 on any port.
# Set to an empty value to disable the pattern and use CORS_ORIGINS only.
# CORS_ORIGIN_REGEX=^https?://(?:localhost|127\.0\.0\.1|\[::1\])(?::\d{1,5})?$

# Gemini API (server-side only). Get a key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here
# Pick a currently supported model from https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-3.6-flash
# Request timeout in seconds and transient-failure retry count (0-3).
GEMINI_TIMEOUT_SECONDS=45
GEMINI_MAX_RETRIES=2
